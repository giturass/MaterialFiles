<!-- The transport controls sit on the scrim over the media, so they take the neutral on-surface
     role rather than the primary role that Material 3 icon buttons use by default. Disabled
     controls still need to read as disabled, which a flat colour cannot express. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:alpha="@dimen/material_emphasis_disabled"
        android:color="?attr/colorOnSurface"
        android:state_enabled="false" />

    <item android:color="?attr/colorOnSurface" />
</selector>
