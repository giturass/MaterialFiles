<!--
  ~ Drawn over the record, not with it, so that it stays still while the disc turns underneath: a
  ~ sheen across the face, a darkened rim, the edge of the label, and the spindle hole.
  -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:centerColor="#00ffffff"
                android:centerX="0.5"
                android:endColor="#1affffff"
                android:startColor="#38ffffff"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="225"
                android:centerColor="#00000000"
                android:centerX="0.5"
                android:endColor="#26000000"
                android:startColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="6dp"
                android:color="#40000000" />
        </shape>
    </item>

    <item
        android:width="@dimen/media_player_audio_cover_label_size"
        android:height="@dimen/media_player_audio_cover_label_size"
        android:gravity="center">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33ffffff" />
        </shape>
    </item>

    <item
        android:width="@dimen/media_player_audio_cover_hole_size"
        android:height="@dimen/media_player_audio_cover_hole_size"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#e6000000" />
            <stroke
                android:width="1dp"
                android:color="#4dffffff" />
        </shape>
    </item>
</layer-list>
