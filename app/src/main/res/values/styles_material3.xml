<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="PrivateResource">

    <style name="Preference.MaterialFiles.SimpleMenuPreference" parent="Preference.SimpleMenuPreference">
        <item name="android:popupMenuStyle">@style/Widget.MaterialFiles.Preference.SimpleMenuPreference.PopupMenu</item>
    </style>
    <style name="Widget.MaterialFiles.Preference.SimpleMenuPreference.PopupMenu" parent="Widget.Preference.SimpleMenuPreference.PopupMenu">
        <item name="android:popupBackground">@drawable/m3_popupmenu_background_overlay</item>
    </style>

    <style name="Preference.MaterialFiles.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/switch_preference_compat_widget_material3</item>
    </style>

    <style name="ShapeAppearance.MaterialFiles.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.MaterialFiles.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.MaterialFiles.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Turns the media player's artwork card into a circle at whatever size it is laid out at. -->
    <style name="ShapeAppearance.MaterialFiles.MediaPlayerAudioCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Brings a component back to a circle where the app's large component shape would otherwise
         round it into a square with soft corners. -->
    <style name="ShapeAppearance.MaterialFiles.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- The artwork fills the round label, so it is cut to the same circle. -->
    <style name="ShapeAppearance.MaterialFiles.MediaPlayerAudioCoverArt" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.MaterialFiles.ListItem" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@string/m3_ref_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/m3_ref_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.MaterialFiles.ListItemSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@string/m3_ref_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/m3_ref_typeface_plain_regular</item>
    </style>

    <style name="Widget.MaterialFiles.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemHorizontalPadding">@dimen/navigation_item_horizontal_padding_material3</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialFiles.SmallComponent</item>
        <item name="itemSubtitleTextAppearance">?textAppearanceBodyMedium</item>
        <item name="itemSubtitleTextColor">@color/navigation_item_subtitle_text_color_material3</item>
        <item name="itemSubtitleTextSize">10sp</item>
        <item name="itemIconPadding">@dimen/navigation_item_icon_padding_material3</item>
        <item name="dividerVerticalPadding">@dimen/design_navigation_separator_vertical_padding</item>
    </style>

    <style name="Widget.MaterialFiles.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.MaterialFiles.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="contentInsetStartWithNavigation">@dimen/abc_action_bar_content_inset_with_nav</item>
    </style>
</resources>
