<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/abc_dialog_title_divider_material">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:scrollIndicators="top|bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tableNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:hint="@string/database_editor_table_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tableNameEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1">
                    <requestFocus />
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Names the columns below, so that the table's own name is not read as the first
                 field of the first column. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:text="@string/database_editor_columns"
                android:textAppearance="?textAppearanceTitleSmall"
                android:textColor="?colorPrimary" />

            <LinearLayout
                android:id="@+id/columnsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addColumnButton"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_edge_margin_minus_4dp"
                android:layout_marginTop="8dp"
                android:text="@string/database_editor_add_column"
                app:icon="@drawable/add_icon_white_24dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/withoutRowIdCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?dialogPreferredPadding"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="?dialogPreferredPadding"
                android:text="@string/database_editor_without_rowid" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
