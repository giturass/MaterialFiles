<!--
  ~ One column's definition. Shared by the new table dialog, which stacks several of these and
  ~ heads each one with its number, and by the add column dialog, which shows a single unheaded one
  ~ without the primary key box.
  ~
  ~ Laid out like the other dialogs in the app: full width fields inset by the dialog's own
  ~ padding, rather than a container of its own.
  -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/screen_edge_margin_minus_8dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?textAppearanceTitleSmall"
            android:textColor="?colorOnSurfaceVariant"
            tools:text="Column 1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/database_editor_remove_column"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/close_icon_control_normal_24dp"
            app:iconSize="20dp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:hint="@string/database_editor_column_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/typeLayout"
        style="?textInputOutlinedExposedDropdownMenuStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:hint="@string/database_editor_column_type">

        <!-- Suggests the storage classes but stays typable, so that a declared type SQLite only
             reads for its affinity, such as VARCHAR(32), can still be entered. -->
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/typeEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text|textCapCharacters|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/defaultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:hint="@string/database_editor_column_default">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/defaultEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/primaryKeyCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:text="@string/database_editor_column_primary_key" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/notNullCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?dialogPreferredPadding"
        android:layout_marginEnd="?dialogPreferredPadding"
        android:text="@string/database_editor_column_not_null" />
</LinearLayout>
