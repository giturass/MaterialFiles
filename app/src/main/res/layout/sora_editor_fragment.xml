<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <me.zhanghai.android.files.ui.CoordinatorAppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/editor">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="?actionBarPopupTheme" />
    </me.zhanghai.android.files.ui.CoordinatorAppBarLayout>

    <me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Neither Sora nor the platform scroll views implement ScrollingView, so
             the container reserves system/IME bottom insets for this entire column. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <me.zhanghai.android.files.viewer.text.SoraEditorSearchPanel
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?colorSurfaceContainer"
                android:scrollbars="vertical"
                android:scrollIndicators="bottom"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/searchQuery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="@string/text_editor_search_query"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/searchPrevious"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_editor_search_previous"
                        app:srcCompat="@drawable/expand_less_icon_control_normal_24dp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/searchNext"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_editor_search_next"
                        app:srcCompat="@drawable/expand_more_icon_control_normal_24dp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/searchClose"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:contentDescription="@string/text_editor_search_close"
                        app:srcCompat="@drawable/close_icon_control_normal_24dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/replacementText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="@string/text_editor_replacement"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/replaceCurrent"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/text_editor_replace_current" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/replaceAll"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/text_editor_replace_all" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/searchMatchCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:accessibilityLiveRegion="polite"
                            android:singleLine="true"
                            android:text="@string/text_editor_search_no_matches"
                            android:textAppearance="?textAppearanceCaption" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/searchMatchCase"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/text_editor_search_match_case"
                            android:textSize="12sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/searchWholeWord"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/text_editor_search_whole_word"
                            android:textSize="12sp" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/searchRegex"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/text_editor_search_regex"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?colorOutlineVariant" />
                </LinearLayout>
            </me.zhanghai.android.files.viewer.text.SoraEditorSearchPanel>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <me.zhanghai.android.files.viewer.text.ThemedCodeEditor
                    android:id="@+id/editor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAutofill="no">
                    <requestFocus />
                </me.zhanghai.android.files.viewer.text.ThemedCodeEditor>

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="16dp"
                    android:gravity="center"
                    android:textAppearance="?textAppearanceListItem"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?colorOutlineVariant" />

            <HorizontalScrollView
                android:id="@+id/symbolScrollView"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="?colorSurface"
                android:fillViewport="true"
                android:scrollbars="none">

                <io.github.rosemoe.sora.widget.SymbolInputView
                    android:id="@+id/symbolInputView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?colorSurface" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:background="?colorSurface"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:textAppearance="?textAppearanceCaption"
                android:textSize="12sp" />
        </LinearLayout>
    </me.zhanghai.android.files.ui.CoordinatorScrollingFrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
