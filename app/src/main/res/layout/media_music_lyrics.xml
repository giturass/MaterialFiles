<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_music_lyrics" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:visibility="gone" android:background="?attr/colorSurface"
    android:paddingHorizontal="24dp" android:paddingVertical="16dp" android:focusable="true"
    android:contentDescription="@string/media_close_lyrics">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/media_lyrics_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:nestedScrollingEnabled="false" />
        <TextView android:id="@+id/media_lyrics_status" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="16dp" android:text="@string/media_lyrics_empty"
            android:focusable="true"
            android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" />
    </FrameLayout>
</LinearLayout>
