{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:if|elif|else|for|while|until|case|select|function)\\b.*(?:then|do|in)?\\s*$|^.*(?:\\{|\\(|\\[)\\s*$",
    "decreaseIndentPattern": "^\\s*(?:fi|done|esac|elif|else|\\}|\\)|\\])\\b?"
  }
}
